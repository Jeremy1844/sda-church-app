{
  "name": "sda-church-app",
  "main": "expo-router/entry",
  "version": "0.23.0",
  "homepage": "https://codesammich.github.io/sda-church-app",
  "scripts": {
    "build:web": "expo export --platform web --clear && node scripts/finalize-web-build.mjs",
    "check": "npm run check:contracts && npm run doctor && npm run typecheck && npm test && npm run build:web",
    "check:contracts": "npm run version:check && npm run check:routes && npm run check:layouts && npm run check:integrity && npm run check:locales && npm run check:links",
    "check:integrity": "node scripts/check-production-integrity.mjs",
    "check:layouts": "node scripts/check-layout-contracts.mjs",
    "check:links": "node scripts/check-external-links.mjs",
    "check:locales": "node scripts/check-locale-registry.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "check:routes": "node public/check-route-contract.mjs",
    "deploy": "node public/deploy-web.js",
    "doctor": "expo-doctor",
    "refresh:latest-activity": "node scripts/refresh-latest-activity.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/*.test.*\"",
    "test:version": "node --test scripts/sync-version.test.js",
    "typecheck": "tsc --noEmit",
    "version:check": "node public/sync-version.js --check",
    "version:sync": "node public/sync-version.js --sync",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "expo": "~55.0.28",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-blur": "~55.0.16",
    "expo-build-properties": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.7",
    "expo-linear-gradient": "~55.0.16",
    "expo-linking": "~55.0.15",
    "expo-localization": "~55.0.17",
    "expo-router": "~55.0.17",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "expo-web-browser": "~55.0.18",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-paper": "^5.15.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-share": "^12.3.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "expo-doctor": "1.20.1",
    "gh-pages": "^6.3.0",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.1"
  },
  "private": true
}
